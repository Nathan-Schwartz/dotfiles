{
  "port": 1337,
  "cacheSeconds": 300,
  "sources": {
    "github": {
      "enabled": true,
      "repoPaths": { "owner/repo": "~/code/repo" }
    },
    "jira": {
      "enabled": true,
      "site": "yourcompany.atlassian.net",
      "project": "PROJ",
      "user": "you@company.com",
      "jql": ""
    }
  },
  "actions": [
    {
      "name": "review",
      "match": { "lanes": "needs-review" },
      "prompt": "Review PR {url} ({repo}#{number}): \"{title}\". Read the diff and leave findings."
    },
    {
      "name": "fix-comments",
      "match": { "type": "pr", "reviewDecision": "CHANGES_REQUESTED" },
      "prompt": "/fix-pr-comments {url}"
    },
    {
      "name": "brainstorm",
      "match": { "type": "jira", "status": ["To Do", "In Progress"] },
      "prompt": "/brainstorm work item {key}: \"{title}\" ({url})",
      "cwd": "~"
    }
  ],
  "launch": {
    "session": "sprintboard",
    "defaultCwd": "~"
  }
}
