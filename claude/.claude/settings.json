{
  "env": {
    "SHELL": "/usr/local/bin/bash"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(file *)",
      "Bash(echo $CLAUDE_CODE_SESSION_ID)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git remote -v)",
      "Bash(tk *)",
      "Bash(git status)",
      "Bash(mkdir -p *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(stat *)",
      "Bash(cat ~/.claude/references/*)",
      "Read(~/.claude/references/*)",
      "Read(~/.claude/references/pkm-schema-reference.md)",
      "Bash(bash ~/dotfiles/scripts/tk-triage-context.sh *)",
      "Bash(qmd *)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(acli:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/block-chained-bash.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Write(**/*.ref.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Write(**/*.synth.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Write(**/*.temp.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Write(**/*.index.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Edit(**/*.ref.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Edit(**/*.synth.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Edit(**/*.temp.md)"
          },
          {
            "type": "command",
            "command": "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/pkm-integrity-hook.sh --post-hook",
            "if": "Edit(**/*.index.md)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "outputStyle": "explanatory",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": false,
  "editorMode": "vim",
  "autoCompactEnabled": false
}
